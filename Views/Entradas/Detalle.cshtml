@using BlogMVC.Servicios
@using BlogMVC.Utilidades
@model EntradaDetalleViewModel
@{
    ViewData["Title"] = Model.Titulo;
    var fechaPublicacionConFormato = Model.FechaPublicacion.ToString("dd MMM, yyyy");
    var urlRetorno = Context.ObtenerUrlRetorno();
}
@*  
     https://localhost:7028/Entradas/Detalle/1
    Ejemplo de URL para esta vista : entradas/detalle/1  
*@

<div class="d-flex justify-content-between align-item-center flex-wrap">

    <h3>@Model.Titulo</h3>

    @*    @if (User.IsInRole(Constantes.CRUDEntradas) || User.IsInRole(Constantes.RolAdmin)) *@
    @if (Model.MostrarBotonEdicion) 
    {
        <div class="d-flex gap-2">
            <a class="btn btn-primary" asp-action="Editar" asp-route-id="@Model.Id">Editar esta entrada</a>

            <form asp-action="Borrar" style="display: inline;">
                <input type="hidden" name="Id" id="Id" value="@Model.Id" />
                
                @if(Model.EntradaBorrada){
                    <button class="btn btn-secondary" asp-action="Borrar"  asp-route-borrado="false"  >Restaurar</button>
                }
                else
                {
                    <button class="btn btn-danger" asp-action="Borrar" asp-route-borrado="true">Eliminar</button>
                }
            </form>
        </div>
        
    }
</div>

<h6>@Model.EscritoPor | @fechaPublicacionConFormato</h6>

@if (!string.IsNullOrEmpty(Model.PortadaUrl))
{
    <img  alt="portada"  src="@Model.PortadaUrl" class="img-fluid"/>
}

<input type="hidden" id="cuerpoDelta" name="cuerpoDelta" value="@Model.Cuerpo" />
<div id="contenido">

</div>

<hr />

@if (Model.Comentarios.Any())
{
    <h2>Comentarios</h2>
    <div class="mb-4">
        @foreach (var comentario in Model.Comentarios)
        {
            <div class="mb-2 p-2 " style="border-left: 1px solid gray">
                <h6>@comentario.EscritoPor</h6>
                <h6>@comentario.FechaPublicacion.ToString("dd, MM yy 'a las' hh:mm tt")</h6>
                <div>
                    @comentario.Cuerpo
                </div>

                @if(comentario.MostrarBotonBorrar){
                    <div class="mt-2">
                        <a class="btn btn-danger" asp-action="borrar" asp-controller="comentarios" asp-route-id="@comentario.Id">Borrar comentario</a>
                    </div>
                }
            </div>
        }
    </div>
}

<h2>Deja un comentario</h2>

@if (User.Identity!.IsAuthenticated)
{
    <form asp-action="Comentar" asp-controller="comentarios">
        <input type="hidden" asp-for="Id" />
        <div style="max-width: 600px;">
            <textarea  id="cuerpo" name="cuerpo" required class="form-control" style="height: 100px;"  placeholder="Escribe un comentario"></textarea>
        </div>

        <div class="d-flex justify-content-end mt-2">
            <button type="submit" class="btn btn-primary">Comenta</button>
        </div>
    </form>
}
else
{
    <p>Loguéate para comentar <a asp-controller="Usuarios" asp-action="login" asp-route-urlRetorno="@urlRetorno">aquí</a>  </p>
}


@section Scripts {
    <script type="module">
        // https://www.jsdelivr.com/package/npm/quill-delta-to-html 
        import { QuillDeltaToHtmlConverter } from "https://cdn.jsdelivr.net/npm/quill-delta-to-html@0.12.1/+esm";

        const deltaString = $("#cuerpoDelta").val();

        /* Se parsea el string a un objeto json */
        const delta = JSON.parse(deltaString);

        /* Instanciar el convertidor */
        const converter = new QuillDeltaToHtmlConverter(delta);
        const contenido = document.getElementById("contenido");
        // Convertir el delta en html
        /* Libreria highlight.js: Permite tener texto en un formato enriquecido */
        contenido.innerHTML = converter.convert();

        
        document.querySelectorAll('pre').forEach(el=>{
            hljs.highlightElement(el);
        });

        /* La anchura del contenedor del texto de la publicacion se acople a la ancchura de la imagend e la publicacion */
        function ajustarAncho(){
            const imagen = document.querySelector("img.img-fluid");
            const contenido = document.getElementById("contenido");

            if(imagen & contenido){
                        contenido.style.width = imagen.clientWidth + "px";// se utiliza clientWidth para obtener la anchura real de la imagen exclyendo bordes e imagenes
            }
        }

        window.addEventListener("load",ajustarAncho);
        window.addEventListener("resize",ajustarAncho);
        
    </script>
}


