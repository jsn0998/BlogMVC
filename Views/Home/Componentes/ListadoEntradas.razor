@using BlogMVC.Datos
@using BlogMVC.Models
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ApplicationDbContext> dbFactory

@* Servicio que permite interactuar codigo de javascript dentro del componente razor *@
@inject IJSRuntime JS

@* Interfaz que permite limpiar recursos no manejados tales como: clases, componentes*@
@implements IDisposable


<h3>ListadoEntradas</h3>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach(var entrada in entradas)
    {
        <div class="col">
            <div class="card h-100">

                @if (string.IsNullOrEmpty(entrada.PortadaUrl))
                {
                    <a href="/entradas/detalle/@entrada.Id">
                        <img src="/img/404.png" class="card-img-top" alt="Portada de la entrada" />
                    </a>
                }
                else
                {
                    <a href="/entradas/detalle/@entrada.Id">
                        <img src="@entrada.PortadaUrl" class="card-img-top" alt="Portada de la entrada" />
                    </a>
                }

                <div class="card-body">
                    <h5 class="card-title">
                        <a 
                            class="text-decoration-none"
                            href="/entradas/detalle/@entrada.Id"
                        >
                            @entrada.Titulo
                        </a>

                        <p class="card-text">
                            <small class="text-body-secondary">
                                @entrada.FechaPublicacion.ToString("dd MM, yyyy")
                            </small>
                        </p>
                    </h5>
                </div>
            </div>
        </div>
    }
</div>

@if (cargando)
{
    <img width="150" class="mt-3" src="img/loading.gif" />
}

<div id="cargar-mas" style="height: 10px;">

</div>

@code {
    private ApplicationDbContext? context { get; set; }
    private List<HomeIndexEntradaViewModel> entradas = [];
    private int indice = 0;// Representa el elemento en el listado de entrad (publicaciones)
    private int cantidadRegistrosSolicitar = 20;
    private bool seguirBuscandoEntradas = true;
    private bool cargando = true;

    protected override async Task OnInitializedAsync()
    {
        /* Obtener el acceso al ApplicationDbContext en este componente */
        context = dbFactory.CreateDbContext();
        await BuscarEntradas();
    }

    /* Cuando el componenete se renderize y por lo tanto ya haya conexion con el navegador se ejecutara esta funcion */
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // return base.OnAfterRenderAsync(firstRender);
        if (firstRender)// si es la primera vez que se renderiza este componente
        {
            // La funcion observarElemento se encuentra el el directorio: C:\Users\Usuario\Documents\manuales\proyectosDesarrollo\.Net\BlogMVC\wwwroot\js\cargar-mas-elementos.js
            // await JS.InvokeVoidAsync("observarElemento", "cargar-mas",DotNetObjectReference.Create(this));// Invocar una funcion de javascript qu eno retornara un valor

            await JS.InvokeVoidAsync("observarElemento","cargar-mas",DotNetObjectReference.Create(this));
        }
    }

    [JSInvokable]
    public async Task CargarMasElementos()
    {
        if (cargando)
        {
            return; 
        }
        if (seguirBuscandoEntradas)
        {
            // Aquí posteriormente colocaremos la lógica para cargar más entradas.
            await BuscarEntradas();
            /* Funcion que actualiza el componente de razor con las nuevas entradas que fuercon agregadas en la variable de entradas */
            StateHasChanged();
        }
    }

    private async Task BuscarEntradas()
    {
        cargando = true;
        StateHasChanged();// se ejecuta para que s emuetsre la imagen del gif
        await Task.Delay(3000);
        var entradasLocal = await context.Entradas
        .Skip(indice)
        .Take(cantidadRegistrosSolicitar)
            .OrderByDescending(x => x.FechaPublicacion)
            .Select(x => new HomeIndexEntradaViewModel
            {
                Id = x.Id,
                Titulo = x.Titulo,
                PortadaUrl = x.PortadaUrl,
                FechaPublicacion = x.FechaPublicacion
            }).ToListAsync();

        /* Si ya no me retorna mas registros de la BD en la variable entradasLocal ya no hay que seguir buscando */
        seguirBuscandoEntradas = entradasLocal.Any();
        entradas.AddRange(entradasLocal);
        indice = indice + cantidadRegistrosSolicitar;// para incrementar de 20 en 20 el indice
        cargando = false;
    }

    public void Dispose()
    {
        /* Se va al context y se hace Dispose para que se limpien los recursos no manejados */
        context?.Dispose();
    }

}
