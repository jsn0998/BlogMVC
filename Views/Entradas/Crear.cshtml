@model EntradaCrearViewModel
@{
    ViewData["Title"] = "Crear Entrada";
}

<h1>Crear una entrada</h1>

<h5>Aquí podemos crear una entrada en el blog</h5>

<div asp-validation-summary="ModelOnly" class="text-danger">

</div>

<form enctype="multipart/form-data" id="formEntrada" asp-action="Crear">
    <div class="mb-3">
        <label asp-for="Titulo" class="form-label"></label>
        <input type="text" autocomplete="off" asp-for="Titulo" id="Titulo"  class="form-control" />
        <span asp-validation-for="Titulo" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Cuerpo" class="form-label"></label>
        <input style="display: none;" asp-for="Cuerpo" class="form-control" />
        <div id="editor"></div>

        <button type="button" onclick="generarCuerpo();" class="btn btn-secondary mt-2">Generar</button>

        @* Span para los errores de validacion el cuerpo *@    
        <span id="cuerpo-error" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ImagenPortada" class="form-label"></label>
        <input type="file" asp-for="ImagenPortada" class="form-control"  onchange="mostrarPrevisualizacion(event);"  />
        <img id="PreviewImagen" class="mt-3" style="display: none;width: 400px;" />
        <span asp-validation-for="ImagenPortada" class="text-danger"></span>
    </div>

    <button type="button" onclick="btnEnviarClick()" class="btn btn-primary">Enviar</button>
    <a class="btn btn-secondary" asp-action="Index" asp-controller="Home">Cancelar</a>

</form>

<div class="modal fade"  id="modal-cuerpo-ia" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true" >
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5 ">Artículo generado por la IA</h1>

                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="output">

                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" onclick="aceptarCambiosCuerpoIA()">Aceptar cambios</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/formulario-entradas.js"></script>      

    <script>
        const modalCuerpoIA = new bootstrap.Modal(document.getElementById('modal-cuerpo-ia'));
        let articuloSugeridoPorIA = "";

        async function generarCuerpo() {

            const titulo = document.getElementById("Titulo").value.trim();

            if (!titulo) {
                alert("Debes ingresar un título para generar el artículo.");
                return;
            }

            const output = document.getElementById('output');

            output.innerHTML = `
                <div class="text-center">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Generando...</span>
                    </div>
                    <p class="mt-2">La IA está generando el artículo...</p>
                </div>
            `;

            articuloSugeridoPorIA = "";
            modalCuerpoIA.show();

            try {

                const respuesta = await fetch('/entradas/GenerarCuerpo?titulo=' + encodeURIComponent(titulo),
                    {
                        method: "GET"
                    }
                );

                if (!respuesta.ok) {
                    const contenido = await respuesta.text();
                    output.innerHTML = "";
                    alert(contenido);
                    modalCuerpoIA.hide();
                    return;
                }

                const reader = respuesta.body.getReader();
                const decoder = new TextDecoder("utf-8");
                let articulo = "";

                while (true) {

                    const { value, done } = await reader.read();
                    if (done) {
                        break;
                    }
                    articulo += decoder.decode(value, {
                        stream: true
                    });

                    output.innerHTML = articulo;
                }

                // Procesar cualquier carácter que haya quedado pendiente
                articulo += decoder.decode();
                output.innerHTML = articulo;
                articuloSugeridoPorIA = articulo;

            } catch (error) {

                console.error(error);

                output.innerHTML = `
                    <div class="alert alert-danger">
                        Ocurrió un error al generar el artículo.
                    </div>
                `;
            }
        }


        function aceptarCambiosCuerpoIA(){

            if (!articuloSugeridoPorIA) {
                return;
            }

            const delta = quill.clipboard.convert({ html: articuloSugeridoPorIA });
            quill.setContents(delta, 'silent');// Agregar el contenido alert editor
            modalCuerpoIA.hide();
        }
    </script>
}




